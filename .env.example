# -----------------------------------------------------------------------------
# AI Engineering Lab - environment variables
#
# Copy this file to .env and adjust the values:
#     cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# Format: KEY=value (no quotes, no spaces around '='). The same file is read by
# Docker Compose and by the Spring Boot service (via spring.config.import).
# -----------------------------------------------------------------------------

# --- PostgreSQL + pgvector (docker-compose.yml) ------------------------------
POSTGRES_DB=ai_lab
POSTGRES_USER=ai_lab
# Local development only. Pick any value; it is never used outside your machine.
POSTGRES_PASSWORD=change-me-local-only
# Host port. 5433 avoids clashing with a PostgreSQL already installed on 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# --- Embedding provider --------------------------------------------------------
# local  -> all-MiniLM-L6-v2 running in-process via ONNX (default, free, no API key)
# openai -> OpenAI text-embedding-3-small (paid API, requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# Only required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Where the local ONNX model (~90 MB) is cached after the first download.
# Defaults to ~/.cache/ai-engineering-lab/onnx. Uncomment to override.
# EMBEDDING_MODEL_CACHE_DIR=/absolute/path/to/model-cache

# --- Service -------------------------------------------------------------------
SERVER_PORT=8080
